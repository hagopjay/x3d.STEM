.DS_Store
__pycache__/
*.pyc
.work/

# Payloads: regenerated by each study's builder, bound by the hashes in cases/*/case.json
studies/*/cases/*/*.png
studies/*/cases/*/*.bin
studies/*/cases/*/*.f32
studies/*/film/*.mp4
studies/*/film/.frames-*/
**/__pycache__/
studies/*/cases/*/*.wav

# Research Loom: ready-to-run distributions include computed banks and renders.
# Source checkouts rebuild them; the index and evidence retain their hashes.
studies/research-loom/web/bank/*.json
!studies/research-loom/web/bank/index.json
studies/research-loom/exports/
studies/research-loom/docs/assets/*.png
